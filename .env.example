# ============================================================
# OpenSSL Build Configuration
# ============================================================
# OpenSSL version for nginx build
# Default: 3.6.2 (stable, compatible with nginx/njs)
# Note: OpenSSL 4.0.0+ requires nginx/njs compatibility verification
# Reference: https://github.com/openssl/openssl/releases/tag/openssl-4.0.0
OPENSSL_VERSION=3.6.2

# ============================================================
# GeoIP Update Configuration
# ============================================================
# MaxMind account credentials (required for geoipupdate service)
# Sign up: https://www.maxmind.com/en/account/login
GEOIPUPDATE_ACCOUNT_ID=your_account_id
GEOIPUPDATE_LICENSE_KEY=your_license_key

# Database edition IDs to download (space-separated)
# GeoLite2 (free): GeoLite2-ASN, GeoLite2-City, GeoLite2-Country
# GeoIP2 (paid): GeoIP2-City, GeoIP2-Country, GeoIP2-ISP, etc.
GEOIPUPDATE_EDITION_IDS=GeoLite2-ASN GeoLite2-City GeoLite2-Country

# Optional: Update frequency (hours). 0 = run once and exit (default for containers)
# GEOIPUPDATE_FREQUENCY=72
